#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <esp_sleep.h>

// Native ESP32 Bluetooth Stack
#include <BLEDevice.h>
#include <BLEUtils.h>
#include <BLEServer.h>
#include <BLE2902.h>
#include <BLEHIDDevice.h> 

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1

#define BUTTON_PIN     2  
#define GROUND_PIN     3  

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);
BLECharacteristic* pHIDInput;
bool bleConnected = false;

// HID Report Map for Media Keys (Volume, Play/Pause, Next, Back)
const uint8_t _hidReportDescriptor[] = {
  0x05, 0x0C,       // Usage Page (Consumer)
  0x09, 0x01,       // Usage (Consumer Control)
  0xA1, 0x01,       // Collection (Application)
  0x85, 0x01,       //   Report ID (1)
  0x15, 0x00,       //   Logical Minimum (0)
  0x25, 0x01,       //   Logical Maximum (1)
  0x09, 0xCD,       //   Usage (Play/Pause)
  0x09, 0xB5,       //   Usage (Scan Next Track)
  0x09, 0xB6,       //   Usage (Scan Previous Track)
  0x75, 0x01,       //   Report Size (1)
  0x95, 0x03,       //   Report Count (3)
  0x81, 0x02,       //   Input (Data,Var,Abs)
  0x75, 0x01,       //   Report Size (1)
  0x95, 0x05,       //   Report Count (5)
  0x81, 0x03,       //   Input (Const,Var,Abs)
  0xC0              // End Collection
};

class MyServerCallbacks : public BLEServerCallbacks {
  void onConnect(BLEServer* pServer) { bleConnected = true; };
  void onDisconnect(BLEServer* pServer) { 
    bleConnected = false; 
    pServer->startAdvertising(); // Restart advertising when disconnected
  }
};

unsigned long lastButtonPress = 0;
unsigned long buttonPressedTime = 0;
int clickCount = 0;
bool waitingForClicks = false;
bool isButtonPressed = false;
const int clickWindow = 450; 

void setup() {
  Serial.begin(115200);
  
  pinMode(GROUND_PIN, OUTPUT);
  digitalWrite(GROUND_PIN, LOW); // Force Pin 3 to act as GND rail
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) { 
    for(;;); 
  }
  
  // Running Boot HW Checks Dashboard
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println("--- SOLO-C3 V1.0 ---");
  display.println("RUNNING HW CHECKS:");
  display.println("");
  display.print("1. DISPLAY : ONLINE\n");
  display.display();
  delay(500);

  display.print("2. BLE CHIP: READY\n");
  display.display();
  delay(500);

  display.print("3. BUTTON  : ");
  if(digitalRead(BUTTON_PIN) == LOW) display.println("WARN (STUCK)");
  else display.println("PASS [OK]");
  display.display();
  delay(1500); 

  // Initialize Native Bluetooth HID Stack
  BLEDevice::init("Solo-C3 Watch");
  BLEServer* pServer = BLEDevice::createServer();
  pServer->setCallbacks(new MyServerCallbacks());

  BLEHIDDevice* hid = new BLEHIDDevice(pServer);
  pHIDInput = hid->inputReport(1); // Report ID 1
  hid->manufacturer       ("DIY");
  hid->pnp                (0x02, 0xe502, 0xa111, 0x0210);
  hid->hidInfo            (0x00, 0x01);
  hid->reportMap          ((uint8_t*)_hidReportDescriptor, sizeof(_hidReportDescriptor));
  hid->startServices      ();

  BLEAdvertising* pAdvertising = pServer->getAdvertising();
  pAdvertising->setAppearance(0x03C4); // Gamepad/Remote appearance
  
  // FIXED LINE FOR COMPILER COMPATIBILITY:
  pAdvertising->addServiceUUID(hid->hidService()->getUUID());
  
  pAdvertising->start();
  
  display.clearDisplay();
}

void loop() {
  int buttonState = digitalRead(BUTTON_PIN);
  unsigned long currentMillis = millis();

  if (buttonState == LOW && !isButtonPressed) {
    if (currentMillis - lastButtonPress > 200) { 
      buttonPressedTime = currentMillis;
      isButtonPressed = true;
      clickCount++;
    }
  }

  if (isButtonPressed && buttonState == LOW) {
    if (currentMillis - buttonPressedTime >= 5000) {
      showActionOverlay("SHUTDOWN", "Sleeping...");
      delay(1000);
      executePowerDown();
    }
  }

  if (isButtonPressed && buttonState == HIGH) {
    isButtonPressed = false;
    lastButtonPress = currentMillis;
    waitingForClicks = true;
  }

  if (waitingForClicks && (currentMillis - lastButtonPress > clickWindow)) {
    if (bleConnected) {
      uint8_t msg = 0;
      switch (clickCount) {
        case 1: // 1 click: Play/Pause
          msg = 0x01; 
          showActionOverlay("MEDIA", "Play / Pause");
          break;
        case 2: // 2 clicks: Next
          msg = 0x02; 
          showActionOverlay("MEDIA", ">> Next Track");
          break;
        case 3: // 3 clicks: Back
          msg = 0x04; 
          showActionOverlay("MEDIA", "<< Previous");
          break;
      }
      if (msg > 0) {
        pHIDInput->setValue(&msg, 1); pHIDInput->notify(); 
        delay(50);
        msg = 0x00;
        pHIDInput->setValue(&msg, 1); pHIDInput->notify(); 
      }
    } else {
      showActionOverlay("PAIR PHONE", "Waiting for BLE...");
    }
    clickCount = 0;
    waitingForClicks = false;
  }

  if (!waitingForClicks && !isButtonPressed) {
    renderMainFace();
  }
}

void renderMainFace() {
  display.clearDisplay();
  display.setTextSize(3);
  display.setCursor(20, 10);
  display.print("12:15"); 
  display.setTextSize(1);
  display.setCursor(22, 48);
  if(bleConnected) display.print("CONNECTED [BLE]");
  else display.print("DISCONNECTED");
  display.display();
}

void showActionOverlay(String contextTitle, String contextStatus) {
  display.clearDisplay();
  display.setTextSize(2);
  display.setCursor(0, 10);
  display.print(contextTitle);
  display.setTextSize(1);
  display.setCursor(0, 42);
  display.print(contextStatus);
  display.display();
}

void executePowerDown() {
  display.clearDisplay();
  display.display();
  
  esp_deep_sleep_enable_gpio_wakeup(1ULL << BUTTON_PIN, ESP_GPIO_WAKEUP_GPIO_LOW); 
  esp_deep_sleep_start(); 
}
